# File: direction2D_c0p06_true.mac
# Brief: 2D direction fit with 0.06 ns Cerenkov emission-time smear and matched TruePos PDF

/rat/db/set DETECTOR geo_file "geo/snoplusnative.geo"
/rat/db/set GEO[inner_av] material "labppo_2p2_bismsb_2p2_scintillator"
/rat/db/set MC cerenkov_emission_time_sigma 0.06

/run/initialize

# BEGIN EVENT LOOP
/rat/proc frontend
/rat/proc trigger
/rat/proc eventbuilder
/rat/proc count
/rat/procset update 10
/rat/proc calibratePMT

/rat/proc fitter
/rat/procset method "quad"

/rat/proc fitter
/rat/procset method "multipdf-scint"
/rat/procset seed "quad"
/rat/procset name "multiPDFFit"

/rat/proc fitter
/rat/procset method "simpleDirection"
/rat/procset seed "multiPDFFit"

/rat/proc fitter
/rat/procset method "directionLikelihood-polar"
/rat/procset optimiser "grid"
/rat/procset pdf "Direction2D"
/rat/procset pdf.index "labppo_2p2_scintillator_cerenk0p06_TruePos_fullvolume"
/rat/procset seed "multiPDFFit"
/rat/procset selector "null"
/rat/procset name "directionFit"

/rat/proc outroot
/rat/procset file "{0}"
# END EVENTLOOP

/generator/add combo gun2:fillshell
/generator/vtx/set e- 0 0 0 0 5 12.5
/generator/pos/set 0 0 0 0 0 0 0 5500
/generator/rate/set 1

/rat/run/start 1000
exit
